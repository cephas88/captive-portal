# Copy this file to .env and fill in your values
# The admin panel (yourdomain.com/admin) is the easier way to configure most settings

SECRET_KEY=change-this-to-a-long-random-string
DATABASE_PATH=captive_portal.db
PORTAL_HOST=0.0.0.0
PORTAL_PORT=5000

# M-Pesa — also configurable in the admin panel
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://yourdomain.com/mpesa-callback
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# Router running nodogsplash
NDS_HOST=192.168.1.1
NDS_PORT=2050

# Branding
HOTSPOT_NAME=QuickNet Hotspot
